{
  "name": "jenkins-calculator-assignment",
  "version": "1.0.0",
  "description": "A simple calculator application with automated tests for Jenkins CI",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "node build.js",
    "pretest": "node scripts/prepare-test-results.js",
    "test": "node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/junit.xml"
  }
}